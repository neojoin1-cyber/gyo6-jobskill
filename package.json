    "extract": "node scripts/extract-questions.cjs",
    "verify": "node scripts/verify-extraction.cjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node scripts/gate-campus-release.mjs",
    "gate:korean-copy": "node scripts/gate-korean-copy.mjs",
    "gate:compact-copy": "node scripts/gate-compact-copy.mjs",
    "gate:writing-support": "node scripts/gate-writing-support.mjs",
    "gate:navigation-flow": "node scripts/gate-navigation-flow.mjs",
    "gate:trial-isolation": "node scripts/gate-trial-isolation.mjs",
    "gate:shared-device": "node scripts/gate-shared-device.mjs",
    "gate:account-deletion": "node scripts/gate-account-deletion.mjs",
    "gate:boot-recovery": "node scripts/gate-boot-recovery.mjs",
    "gate:release-security": "node scripts/gate-release-security.mjs --source",
    "gate:paid-api": "node scripts/gate-paid-api-boundary.mjs",
    "gate:release-automation": "node scripts/gate-release-automation.mjs",
    "gate:questions": "python scripts/gate-question-quality.py",
    "prebuild": "node scripts/gate-campus-release.mjs && node scripts/gate-student-navigation.mjs && npm run gate:korean-copy && npm run gate:compact-copy && npm run gate:writing-support && npm run gate:navigation-flow && npm run gate:trial-isolation && npm run gate:shared-device && npm run gate:account-deletion && npm run gate:boot-recovery && npm run gate:release-security && npm run gate:paid-api && npm run gate:release-automation && npm run verify:content-rights && npm run verify:question-priority && npm run verify:quality-food && npm run verify:official && npm run verify:teacher-release && npm run verify:guidance-routes && npm run verify:first-class && npm run verify:autonomous-close && npm run verify:wrong-repeat && npm run verify:practical-choices && npm run verify:learning-experience && npm run verify:contextual-deepening && npm run verify:learning-render && npm run verify:context-materials && npm run verify:learning-capacity && npm run verify:assessment-separation && npm run verify:assessment-identity && npm run verify:personalized-career && python scripts/gate-question-quality.py && python scripts/gate-hook-order.py && npm run gate:exam",
    "gate:hooks": "python scripts/gate-hook-order.py",
    "gate:exam": "npx esbuild scripts/gate-exam-fidelity.mjs --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/gate-exam.mjs --log-level=error && node .cache/gate-exam.mjs",
    "release:migrations": "node scripts/release/apply-linked-migrations.mjs",
    "release:sync": "node scripts/release/verify-device-sync-remote.mjs",
    "release:android": "node scripts/release/verify-android-recovery.mjs",
    "release:verify": "npm run release:migrations -- --apply && npm run release:sync && npm run release:android",
    "internal:aab": "node scripts/release/build-internal-aab.mjs",
    "internal:test": "npm run release:migrations && npm run release:sync && npm run release:android && npm run internal:aab -- --skip-sync"
  },
  "keywords": [],
  "author": "",
