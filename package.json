    "verify:learning-render": "npx esbuild scripts/audit-learning-render.mjs --bundle --platform=node --format=esm --packages=external --jsx=automatic --loader:.json=json --outfile=.cache/audit-learning-render.mjs --log-level=error && node .cache/audit-learning-render.mjs",
    "verify:context-materials": "npx esbuild scripts/audit-contextual-materials.mjs --bundle --platform=node --format=esm --packages=external --jsx=automatic --loader:.json=json --outfile=.cache/audit-contextual-materials.mjs --log-level=error && node .cache/audit-contextual-materials.mjs",
    "verify:content-rights": "node scripts/gate-official-content-rights.mjs",
    "verify:question-priority": "npx esbuild scripts/audit-question-priority.mjs --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/audit-question-priority.mjs --log-level=error && node .cache/audit-question-priority.mjs",
