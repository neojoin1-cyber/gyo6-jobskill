    "verify:assessment-separation": "npx esbuild scripts/audit-assessment-separation.mjs --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/audit-assessment-separation.mjs --log-level=error && node .cache/audit-assessment-separation.mjs",
    "verify:assessment-identity": "npx esbuild scripts/audit-assessment-identity.mjs --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/audit-assessment-identity.mjs --log-level=error && node .cache/audit-assessment-identity.mjs",
