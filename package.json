    "verify:first-class": "npx esbuild scripts/audit-first-class-lessons.mjs --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/audit-first-class-lessons.mjs --log-level=error && node .cache/audit-first-class-lessons.mjs",
    "verify:autonomous-close": "npx esbuild scripts/audit-autonomous-formative.mjs --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/audit-autonomous-formative.mjs --log-level=error && node .cache/audit-autonomous-formative.mjs",
    "verify:wrong-repeat": "node scripts/verify-wrong-repeat.mjs",
    "verify:practical-choices": "node scripts/audit-practical-choice-quality.mjs",
