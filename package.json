{
  "name": "gyo6-jobskill-game",
  "version": "1.0.0",
  "description": "직업공통능력 교재 매치3+퀴즈 하이브리드 게임 학습 앱",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "live": "vite --port 7700 --strictPort --host 127.0.0.1",
    "build": "vite build",
    "postbuild": "node scripts/gate-deployment-safety.mjs",
    "verify:official": "node scripts/audit-official-alignment.mjs && node scripts/audit-interview-release.mjs && node scripts/audit-launch-content.mjs",
    "verify:interview": "node scripts/audit-interview-release.mjs",
    "verify:launch-content": "node scripts/audit-launch-content.mjs",
    "verify:quality-food": "node scripts/audit-quality-food-gate.mjs",
    "audio:manifest": "node scripts/build-listening-manifest.mjs",
    "audio:bundle": "npx esbuild src/lib/jobCommonAreas.js --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/jc.mjs --log-level=error",
    "audio:generate": "npm run audio:bundle && node scripts/gen-listening-audio.mjs",
    "audio:regenerate": "npm run audio:bundle && node scripts/gen-listening-audio.mjs --force && npm run audio:manifest",
    "verify:production-flows": "node scripts/verify-production-flows.mjs",
    "verify:teacher-release": "node scripts/verify-teacher-release.mjs",
    "verify:learning-experience": "npx esbuild scripts/audit-learning-experience.mjs --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/audit-learning-experience.mjs --log-level=error && node .cache/audit-learning-experience.mjs",
    "verify:learning-render": "npx esbuild scripts/audit-learning-render.mjs --bundle --platform=node --format=esm --packages=external --jsx=automatic --loader:.json=json --outfile=.cache/audit-learning-render.mjs --log-level=error && node .cache/audit-learning-render.mjs",
    "verify:learning-capacity": "npx esbuild scripts/audit-learning-capacity.mjs --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/audit-learning-capacity.mjs --log-level=error && node .cache/audit-learning-capacity.mjs",
    "verify:assessment-separation": "npx esbuild scripts/audit-assessment-separation.mjs --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/audit-assessment-separation.mjs --log-level=error && node .cache/audit-assessment-separation.mjs",
    "verify:assessment-identity": "npx esbuild scripts/audit-assessment-identity.mjs --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/audit-assessment-identity.mjs --log-level=error && node .cache/audit-assessment-identity.mjs",
    "audit:learning": "npx esbuild scripts/audit-learning-readiness.mjs --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/audit-learning-readiness.mjs --log-level=error && node .cache/audit-learning-readiness.mjs",
    "verify:recruit-written": "node scripts/audit-recruit-written-gate.mjs",
    "extract": "node scripts/extract-questions.cjs",
    "verify": "node scripts/verify-extraction.cjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node scripts/gate-campus-release.mjs",
    "gate:korean-copy": "node scripts/gate-korean-copy.mjs",
    "gate:compact-copy": "node scripts/gate-compact-copy.mjs",
    "gate:trial-isolation": "node scripts/gate-trial-isolation.mjs",
    "gate:questions": "python scripts/gate-question-quality.py",
    "prebuild": "node scripts/gate-campus-release.mjs && node scripts/gate-student-navigation.mjs && npm run gate:korean-copy && npm run gate:compact-copy && npm run gate:trial-isolation && npm run verify:interview && npm run verify:teacher-release && npm run verify:learning-experience && npm run verify:learning-render && npm run verify:learning-capacity && npm run verify:assessment-separation && npm run verify:assessment-identity && python scripts/gate-question-quality.py && python scripts/gate-hook-order.py && npm run gate:exam",
    "gate:hooks": "python scripts/gate-hook-order.py",
    "gate:exam": "npx esbuild scripts/gate-exam-fidelity.mjs --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/gate-exam.mjs --log-level=error && node .cache/gate-exam.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.108.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "cheerio": "^1.2.0",
    "pg": "^8.22.0",
    "sharp": "^0.35.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
