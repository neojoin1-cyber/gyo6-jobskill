{
  "name": "gyo6-jobskill-game",
  "version": "1.0.0",
  "description": "직업공통능력 교재 매치3+퀴즈 하이브리드 게임 학습 앱",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "live": "vite --port 7700 --strictPort --host 127.0.0.1",
    "build": "vite build",
    "build:native": "npm run prebuild && vite build --mode native && node scripts/gate-native-runtime.mjs",
    "android:sync": "npm run build:native && npx cap sync android && node scripts/gate-native-runtime.mjs --android",
    "postbuild": "node scripts/gate-deployment-safety.mjs && node scripts/gate-release-security.mjs --dist",
    "verify:official": "node scripts/audit-official-alignment.mjs && node scripts/audit-interview-release.mjs && node scripts/audit-launch-content.mjs",
    "verify:interview": "node scripts/audit-interview-release.mjs",
    "verify:launch-content": "node scripts/audit-launch-content.mjs",
    "verify:quality-food": "node scripts/audit-quality-food-gate.mjs",
    "audio:manifest": "node scripts/build-listening-manifest.mjs",
    "audio:bundle": "npx esbuild src/lib/jobCommonAreas.js --bundle --platform=node --format=esm --loader:.json=json --outfile=.cache/jc.mjs --log-level=error",
    "audio:generate": "npm run audio:bundle && node scripts/gen-listening-audio.mjs",
    "audio:regenerate": "npm run audio:bundle && node scripts/gen-listening-audio.mjs --force && npm run audio:manifest",
    "verify:production-flows": "node scripts/verify-production-flows.mjs",
