# Supabase 연결 정보 (프로젝트 대시보드 > Settings > API 에서 확인)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 교사 수업자료 허브 주소 (정적 사이트). 비우면 앱에 카드가 표시되지 않는다.
VITE_TEACHER_MATERIALS_URL=

# 제작·검수 중에는 false. 정식 공개 체험을 15분으로 제한할 때만 true.
VITE_TRIAL_TIME_LIMIT_ENABLED=false
# Supabase Edge Function에는 같은 값으로 PUBLIC_TRIAL_TIME_LIMIT_ENABLED를 설정한다.
